{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.heliograph-io/heliograph",
  "description": "Run commands on a machine you cannot SSH into. Air-gapped, bastion-only, change-controlled.",
  "repository": {
    "url": "https://github.com/heliograph-io/heliograph",
    "source": "github"
  },
  "version": "0.4.3",
  "websiteUrl": "https://docs.heliograph.io",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@dbhq/heliograph",
      "version": "0.4.3",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "npx",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "-y",
          "isRequired": true,
          "format": "string"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "isRequired": true,
          "format": "string"
        }
      ]
    }
  ]
}
